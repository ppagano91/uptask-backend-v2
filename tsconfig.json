{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "lib": ["esnext", "dom"],
    "target": "ESNext",
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,
    "jsx": "react-jsx"  // Esto es importante para los proyectos que usan JSX
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"] // Asegúrate de incluir también archivos .tsx si usas React
}
